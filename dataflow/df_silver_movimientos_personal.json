{
	"name": "df_silver_movimientos_personal",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_bronze_movimientos_personal",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_silver_tbl_movimientos_personal",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id_movimiento as integer,",
				"          id_efectivo as integer,",
				"          id_unidad_destino as integer,",
				"          id_rango as integer,",
				"          id_tipo as integer,",
				"          fecha_movimiento as string,",
				"          antiguedad_anios as string,",
				"          salario_mensual as string,",
				"          observaciones as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT\\n    id_movimiento,\\n    id_efectivo,\\n    id_unidad_destino,\\n    id_rango,\\n    id_tipo,\\n\\n    TRIM(fecha_movimiento) AS fecha_movimiento,\\n    TRIM(antiguedad_anios) AS antiguedad_anios,\\n    TRIM(salario_mensual) AS salario_mensual,\\n    TRIM(observaciones) AS observaciones\\n\\nFROM bronze.tbl_movimientos_personal',",
				"     format: 'query') ~> source1",
				"source1 derive(fecha_movimiento = iif(\r",
				"    isNull(fecha_movimiento)\r",
				"    || trim(fecha_movimiento) == ''\r",
				"    || upper(trim(fecha_movimiento)) == 'NULL',\r",
				"\r",
				"    toDate('1900-01-01'),\r",
				"\r",
				"    coalesce(\r",
				"\r",
				"        toDate(fecha_movimiento, 'yyyy/MM/dd'),\r",
				"        toDate(fecha_movimiento, 'yyyy-MM-dd'),\r",
				"\r",
				"        toDate(fecha_movimiento, 'dd/MM/yyyy'),\r",
				"        toDate(fecha_movimiento, 'dd-MM-yyyy'),\r",
				"\r",
				"        toDate(fecha_movimiento, 'MM-dd-yyyy'),\r",
				"\r",
				"        toDate(\r",
				"            toString(fecha_movimiento),\r",
				"            'yyyyMMdd'\r",
				"        ),\r",
				"\r",
				"        toDate('1900-01-01')\r",
				"    )\r",
				"),",
				"          salario_mensual = iif(    isNull(salario_mensual) ||     in(['null', 'NULL', 'n/a', '---', ''], trim(salario_mensual)),    toDecimal(null(), 18, 2),        toDecimal(        iif(            /* REGLA 1: Si es un número entero puro sin puntos ni comas (Ej: 2053 o 2288) */            rlike(trim(regexReplace(regexReplace(trim(salario_mensual), `^(?i)[b\\s\\.s-]*`, ''), `(?i)[b\\s\\.s-]*$`, '')), `^\\d+$`),            /* Le agregamos el .00 al final */            trim(regexReplace(regexReplace(trim(salario_mensual), `^(?i)[b\\s\\.s-]*`, ''), `(?i)[b\\s\\.s-]*$`, '')) + '.00',                        /* REGLA 2: Para los números con puntos o comas (Ej: 6.482.12 o 3,661.53) */            regexReplace(                /* Primero: Volvemos todas las comas en puntos */                replace(trim(regexReplace(regexReplace(trim(salario_mensual), `^(?i)[b\\s\\.s-]*`, ''), `(?i)[b\\s\\.s-]*$`, '')), ',', '.'),                /* Segundo: Buscamos el punto seguido de 3 dígitos (miles) y lo borramos */                `\\.([0-9]{3})`,                `$1`            )        ),        18,        2    )),",
				"          antiguedad_anios = iif(\r",
				"    isNull(antiguedad_anios) || in(['null', 'NULL', 'n/a', '---', ''], trim(antiguedad_anios)),\r",
				"    toInteger(null()),\r",
				"    \r",
				"    toInteger(\r",
				"        case(\r",
				"            /* 1. MAPEO DE PALABRAS ESCRITAS EN LETRAS */\r",
				"            in(['cero', 'cero años', 'cero año'], lower(trim(antiguedad_anios))), '0',\r",
				"            in(['uno', '1 año', '1 años', 'uno años', 'uno año'], lower(trim(antiguedad_anios))), '1',\r",
				"            in(['dos', 'dos años'], lower(trim(antiguedad_anios))), '2',\r",
				"            in(['tres', 'tres años'], lower(trim(antiguedad_anios))), '3',\r",
				"            in(['cuatro', 'cuatro años'], lower(trim(antiguedad_anios))), '4',\r",
				"            in(['cinco', 'cinco años'], lower(trim(antiguedad_anios))), '5',\r",
				"            in(['seis', 'seis años'], lower(trim(antiguedad_anios))), '6',\r",
				"            in(['siete', 'siete años'], lower(trim(antiguedad_anios))), '7',\r",
				"            in(['ocho', 'ocho años'], lower(trim(antiguedad_anios))), '8',\r",
				"            in(['nueve', 'nueve años'], lower(trim(antiguedad_anios))), '9',\r",
				"            in(['diez', 'diez años'], lower(trim(antiguedad_anios))), '10',\r",
				"            in(['once', 'once años'], lower(trim(antiguedad_anios))), '11',\r",
				"            in(['doce', 'doce años'], lower(trim(antiguedad_anios))), '12',\r",
				"            in(['trece', 'trece años'], lower(trim(antiguedad_anios))), '13',\r",
				"            in(['catorce', 'catorce años'], lower(trim(antiguedad_anios))), '14',\r",
				"            in(['quince', 'quince años'], lower(trim(antiguedad_anios))), '15',\r",
				"            in(['dieciséis', 'dieciséis años'], lower(trim(antiguedad_anios))), '16',\r",
				"            in(['diecisiete', 'diecisiete años'], lower(trim(antiguedad_anios))), '17',\r",
				"            in(['dieciocho', 'dieciocho años'], lower(trim(antiguedad_anios))), '18',\r",
				"            in(['diecinueve', 'diecinueve años'], lower(trim(antiguedad_anios))), '19',\r",
				"            in(['veinte', 'veinte años'], lower(trim(antiguedad_anios))), '20',\r",
				"            in(['veintiuno', 'veintiuno años'], lower(trim(antiguedad_anios))), '21',\r",
				"            in(['veintidós', 'veintidós años'], lower(trim(antiguedad_anios))), '22',\r",
				"            in(['veintitrés', 'veintitrés años'], lower(trim(antiguedad_anios))), '23',\r",
				"            in(['veinticuatro', 'veinticuatro años'], lower(trim(antiguedad_anios))), '24',\r",
				"            in(['veinticinco', 'veinticinco años'], lower(trim(antiguedad_anios))), '25',\r",
				"            \r",
				"            /* 2. PROCESAMIENTO, REDONDEO EXPLÍCITO Y CONVERSIÓN A CADENA */\r",
				"            true(), \r",
				"            toString(\r",
				"                round(\r",
				"                    toFloat(\r",
				"                        replace(\r",
				"                            regexReplace(lower(trim(antiguedad_anios)), `(?i)(aprox\\.|años|año|a\\.)`, ''),\r",
				"                            ',', '.'\r",
				"                        )\r",
				"                    ),\r",
				"                    0,\r",
				"                    5\r",
				"                )\r",
				"            )\r",
				"        )\r",
				"    )\r",
				")\r",
				",",
				"          observaciones = iif(\r",
				"    isNull(observaciones) ||\r",
				"    trim(observaciones) == '' ||\r",
				"    lower(trim(observaciones)) == 'n/a' ||\r",
				"    lower(trim(observaciones)) == 's/n' ||\r",
				"    lower(trim(observaciones)) == 'sin obs.' ||\r",
				"    lower(trim(observaciones)) == 'sin observacion' ||\r",
				"    lower(trim(observaciones)) == 'sin observaciones' ||\r",
				"    lower(trim(observaciones)) == 'null' ||\r",
				"    trim(observaciones) == '-' ,\r",
				"\r",
				"    'Sin Observacion',\r",
				"\r",
				"    initCap(\r",
				"        trim(\r",
				"            regexReplace(observaciones, '\\\\s+', ' ')\r",
				"        )\r",
				"    )\r",
				")) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          id_movimiento as integer,",
				"          id_efectivo as integer,",
				"          id_unidad_destino as integer,",
				"          id_rango as integer,",
				"          id_tipo as integer,",
				"          fecha_movimiento as date,",
				"          antiguedad_anios as integer,",
				"          salario_mensual as decimal(18,2),",
				"          observaciones as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          id_movimiento,",
				"          id_efectivo,",
				"          id_unidad_destino,",
				"          id_rango,",
				"          id_tipo,",
				"          fecha_movimiento,",
				"          antiguedad_anios,",
				"          salario_mensual,",
				"          observaciones",
				"     )) ~> sink1"
			]
		}
	}
}